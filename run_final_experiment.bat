@echo off
chcp 65001
cls

echo ========================================================
echo   [ABSA 期末大决战] 多维度消融实验流水线全面启动
echo   最优超参锚定: Dim=300, Layers=1, Epochs=40
echo ========================================================
echo.

:: --------------------------------------------------------
:: 实验 0：完全体模型 (The Full Model - 论文里的 Baseline)
:: --------------------------------------------------------
echo 📊 [1/4] 正在运行：完全体模型 (包含所有机制)...
python train.py --epochs 40 --gcn_dim 300 --num_layers 1 --use_gcn 1 --use_attn 1 --use_real_adj 1
echo [OK] 完全体运行结束，结果已记账。
echo --------------------------------------------------------

:: --------------------------------------------------------
:: 实验 1：剥离 GCN 模块 (w/o GCN)
:: 目的：量化证明图神经网络在捕捉长距离情感依赖中的核心地位
:: --------------------------------------------------------
echo 📊 [2/4] 正在运行：消融组 w/o GCN (切断图卷积)...
python train.py --epochs 40 --gcn_dim 300 --num_layers 1 --use_gcn 0 --use_attn 1 --use_real_adj 1
echo [OK] 无 GCN 组运行结束，结果已记账。
echo --------------------------------------------------------

:: --------------------------------------------------------
:: 实验 2：剥离自注意力机制 (w/o Attention)
:: 目的：证明注意力机制在解决“多修饰语冲突”时的权重分配作用
:: --------------------------------------------------------
echo 📊 [3/4] 正在运行：消融组 w/o Attention (剥离注意力机制)...
python train.py --epochs 40 --gcn_dim 300 --num_layers 1 --use_gcn 1 --use_attn 0 --use_real_adj 1
echo [OK] 无 Attention 组运行结束，结果已记账。
echo --------------------------------------------------------

:: --------------------------------------------------------
:: 实验 3：句法树随机化 (w/ Random Adj)
:: 目的：反向证明真实的 spaCy 句法拓扑相比随机拓扑的绝对优越性
:: --------------------------------------------------------
echo 📊 [4/4] 正在运行：消融组 Random Adj (随机摧毁真实句法树)...
python train.py --epochs 40 --gcn_dim 300 --num_layers 1 --use_gcn 1 --use_attn 1 --use_real_adj 0
echo [OK] 随机矩阵组运行结束，结果已记账。
echo.

